# ==============================================================================
# FundOS Production Environment Variables Configuration Template
# ==============================================================================

# Core Node Settings
NODE_ENV=production
PORT=3001

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://fundos_admin:YOUR_SECURE_PASSWORD_HERE@localhost:5435/fundos_db?schema=public

# Cache Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6382

# Security & Sessions
# Generate a cryptographically secure key (e.g. using `openssl rand -base64 32`)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE

# Payment Gateways (Stripe API)
# Get keys from Stripe Developer Dashboard
STRIPE_SECRET_KEY=sk_prod_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI Coaching & NLP Configurations
# Optional: Set to your LLM completion endpoints or tokens if needed
AI_COACH_API_KEY=your_ai_token_here
